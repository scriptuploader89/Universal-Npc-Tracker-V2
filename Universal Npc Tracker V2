-- AUTO-START
-- =====================================================================
local success, err = pcall(CreateRadar)
if not success then
    warn("[NPC Radar] Failed to load: " .. tostring(err))
    -- Retry after a short delay
    task.wait(1)
    pcall(CreateRadar)
end
