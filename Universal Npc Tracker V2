local function updateRadarPosition()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local viewport = cam.ViewportSize
    state.radarCenter = Vector2.new(
        viewport.X - CONFIG.RADAR_RADIUS - 30,
        CONFIG.RADAR_RADIUS + 40
    )
    state.sliderY = state.radarCenter.Y + CONFIG.RADAR_RADIUS + 20
    state.sliderStartX = state.radarCenter.X - CONFIG.SLIDER_WIDTH / 2
    state.sliderEndX = state.radarCenter.X + CONFIG.SLIDER_WIDTH / 2
end
updateRadarPosition()

local function createDrawing(dtype, properties)
    local success, obj = pcall(function()
        return Drawing.new(dtype)
    end)
    if not success or not obj then
        return nil
    end
    for k, v in pairs(properties) do
        pcall(function() obj[k] = v end)
    end
    return obj
end

