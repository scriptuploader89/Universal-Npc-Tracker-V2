            nameLabel.TextFont = Enum.Font.Gotham
            nameLabel.Font = Enum.Font.Gotham
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.TextYAlignment = Enum.TextYAlignment.Center
            nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
            nameLabel.Parent = entry

            local distLabel = Instance.new("TextLabel")
            distLabel.Name = "DistLabel"
            distLabel.Size = UDim2.new(0.5, -5, 1, 0)
            distLabel.Position = UDim2.new(0.5, 5, 0, 0)
            distLabel.BackgroundTransparency = 1
            distLabel.TextColor3 = CONFIG.Colors.DistanceText
            distLabel.TextSize = 10
            distLabel.TextFont = Enum.Font.Gotham
            distLabel.Font = Enum.Font.Gotham
            distLabel.TextXAlignment = Enum.TextXAlignment.Right
            distLabel.TextYAlignment = Enum.TextYAlignment.Center
            distLabel.Parent = entry
        end
        entry.Visible = true
        return entry
    end

    -- Return entry to pool
    local function returnNPCEntry(entry)
        entry.Visible = false
        table.insert(npcEntryPool, entry)
    end

    -- Clean all pools
    local function clearBlips()
        for _, blip in ipairs(blipContainer:GetChildren()) do
            if blip.Name == "Blip" then
                returnBlip(blip)
            end
        end
    end

    local function clearNPCEntries()
        for _, entry in ipairs(npcListScrolling:GetChildren()) do
            if entry.Name == "NPCEntry" then
                returnNPCEntry(entry)
            end
        end
    end

    -- =====================================================================
    -- MAIN UPDATE FUNCTION
    -- =====================================================================
    local function UpdateRadar()
        local player = Players.LocalPlayer
        if not player then return end
        local character = player.Character
        if not character then return end

        local humanoidRoot = character:FindFirstChild("HumanoidRootPart")
        if not humanoidRoot then return end

        local playerPos = humanoidRoot.Position
        local playerCF = humanoidRoot.CFrame

        -- Update compass
        local dir, degreesVal = GetCompassDirection(playerCF)
        compassLabel.Text = "N  ·  E  ·  S  ·  W"
        directionIndicator.Text = dir
        if dir == "N" then
            directionIndicator.TextColor3 = CONFIG.Colors.CompassN
        else
            directionIndicator.TextColor3 = CONFIG.Colors.CompassEWS
        end

        -- Update player arrow rotation
        local lookVector = playerCF.LookVector
        local playerAngle = math.deg(math.atan2(-lookVector.X, -lookVector.Z))
        playerArrow.Rotation = playerAngle

        -- Find all NPCs
        local npcs = {}
        for _, descendant in ipairs(workspace:GetDescendants()) do
            if IsNPC(descendant) then
                local npcPos = GetNPCPosition(descendant)
                if npcPos then
                    local distance = (npcPos - playerPos).Magnitude
                    if distance <= radarRadius then
                        table.insert(npcs, {
                            Instance = descendant,
                            Position = npcPos,
                            Distance = distance,
                            Direction = GetNPCDirection(descendant)
                        })
                    end
                end
            end
        end

        -- Sort by distance
        table.sort(npcs, function(a, b)
            return a.Distance < b.Distance
        end)

        -- Clear old blips and entries
        clearBlips()
        clearNPCEntries()

        -- Scale factor: radar half-size / radius
        local halfRadar = CONFIG.RadarSize / 2
        local scale = halfRadar / radarRadius

        -- Place blips
        for _, npcData in ipairs(npcs) do
            local npc = npcData.Instance
            local npcPos = npcData.Position
            local distance = npcData.Distance
            local npcAngle = npcData.Direction

            local relativePos = npcPos - playerPos
            -- Rotate relative position by player's inverse rotation
            local playerYaw = math.atan2(-lookVector.X, -lookVector.Z)
            local cosA = math.cos(playerYaw)
            local sinA = math.sin(playerYaw)
            local rotatedX = relativePos.X * cosA - relativePos.Z * sinA
            local rotatedZ = relativePos.X * sinA + relativePos.Z * cosA

            -- Negate Z for screen coordinates (forward = up on screen)
            local screenX = rotatedX * scale
            local screenY = -rotatedZ * scale

            -- Clamp to radar bounds (circle)
            local blipRadius = math.sqrt(screenX * screenX + screenY * screenY)
            local maxBlipRadius = halfRadar - 6
            if blipRadius > maxBlipRadius then
                screenX = screenX / blipRadius * maxBlipRadius
                screenY = screenY / blipRadius * maxBlipRadius
                blipRadius = maxBlipRadius
            end

            -- Get or create blip
            local blip = getBlip()
            blip.Position = UDim2.new(0.5, screenX - 4, 0.5, screenY - 4)

            -- Set color based on distance
            if distance <= CONFIG.DistanceThreshold then
                blip.ImageColor3 = CONFIG.Colors.NPCRed
            else
                blip.ImageColor3 = CONFIG.Colors.NPCOrange
            end

            -- Set NPC direction arrow rotation
            local npcDirArrow = blip:FindFirstChild("NPCDir")
            if npcDirArrow then
                local npcAngleDeg = math.deg(npcAngle)
                -- Adjust: NPC angle relative to player's view
                npcDirArrow.Rotation = npcAngleDeg - playerAngle
            end

            -- Create list entry
            local entry = getNPCEntry(npc)
            local dot = entry:FindFirstChild("Dot")
            local nameLabel = entry:FindFirstChild("NameLabel")
            local distLabel = entry:FindFirstChild("DistLabel")

            if dot then
                if distance <= CONFIG.DistanceThreshold then
                    dot.BackgroundColor3 = CONFIG.Colors.NPCRed
                else
                    dot.BackgroundColor3 = CONFIG.Colors.NPCOrange
                end
            end
            if nameLabel then
                local npcName = npc.Name
                if #npcName > 18 then
                    npcName = npcName:sub(1, 16) .. ".."
                end
                nameLabel.Text = npcName
            end
            if distLabel then
                distLabel.Text = RoundNumber(distance) .. "m"
            end
        end
    end

    -- =====================================================================
    -- START THE UPDATE LOOP
    -- =====================================================================
    coroutine.wrap(function()
        while true do
            pcall(UpdateRadar)
            task.wait(CONFIG.RefreshRate)
        end
    end)()

    -- =====================================================================
    -- CHARACTER RESPAWN HANDLING
    -- =====================================================================
    player.CharacterAdded:Connect(function(newChar)
        -- Wait a bit for character to load
        task.wait(1)
    end)

    -- =====================================================================
    -- RETURN GUI
    -- =====================================================================
    return gui
end

