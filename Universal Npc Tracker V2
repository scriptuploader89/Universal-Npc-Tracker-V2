-- Functions
local function getCamHeading()
    local cam = Workspace.CurrentCamera
    if not cam then return 0 end
    local lv = cam.CFrame.LookVector
    return math.atan2(lv.X, lv.Z)
end

local function worldToRadar(worldPos, playerPos, radius)
    local dx = worldPos.X - playerPos.X
    local dz = worldPos.Z - playerPos.Z
    local dist = math.sqrt(dx * dx + dz * dz)
    if dist < 0.01 then
        return Vector2.new(radarCX, radarCY), 0
    end
    local scale = RADAR_RADIUS / radius
    local scaled = dist * scale
    local clamped = math.min(scaled, RADAR_RADIUS - DOT_R - 2)
    local angle = math.atan2(dx, dz)
    local sx = radarCX + math.sin(angle) * clamped
    local sy = radarCY - math.cos(angle) * clamped
    return Vector2.new(sx, sy), dist
end

local function sliderXtoRadius(x)
    local ratio = (x - sliderStartX) / SLIDER_W
    ratio = math.clamp(ratio, 0, 1)
    return math.floor(1 + ratio * (MAX_RADIUS - 1))
end

local function radiusToSliderX(r)
    local ratio = (r - 1) / (MAX_RADIUS - 1)
    return sliderStartX + ratio * SLIDER_W
end

-- Update visuals
local function updateSlider()
    local tx = radiusToSliderX(currentRadius)
    local tp = Vector2.new(tx, sliderY)
    if sliderThumb then
        sliderThumb.Position = tp
        sliderThumb.Color = locked and COL_THUMB_LOCKED or COL_THUMB
    end
    if sliderThumbB then
        sliderThumbB.Position = tp
        sliderThumbB.Color = locked and COL_THUMBB_LOCKED or COL_WHITE
    end
    if radiusText then
        radiusText.Text = "Radius: " .. currentRadius .. "m"
        radiusText.Position = Vector2.new(radarCX, sliderY + 18)
        radiusText.Color = locked and COL_TEXT_LOCKED or COL_TEXT
    end
end

local function updateLock()
    local lcx = sliderEndX + LOCK_SIZE / 2 + 12
    local lcy = sliderY
    local lcp = Vector2.new(lcx, lcy)
    if lockBg then
        lockBg.Position = lcp
        lockBg.Color = locked and COL_LOCK or COL_UNLOCK
    end
    if lockBorder then
        lockBorder.Position = lcp
    end
    if lockText then
        lockText.Position = lcp
        lockText.Text = locked and "L" or "U"
    end
end

local function updateCompass()
    for _, item in ipairs(compassItems) do
        if item.label then
            local lx = radarCX + math.sin(item.angle) * (RADAR_RADIUS + 12)
            local ly = radarCY - math.cos(item.angle) * (RADAR_RADIUS + 12)
            item.label.Position = Vector2.new(lx, ly)
            item.label.Color = (item.angle == 0) and COL_GOLD or COL_COMPASS
        end
    end
    for _, tick in ipairs(tickLines) do
        if tick.line then
            local ir = RADAR_RADIUS - 6
            local ora = RADAR_RADIUS - 2
            local fx = radarCX + math.sin(tick.angle) * ir
            local fy = radarCY - math.cos(tick.angle) * ir
            local tx = radarCX + math.sin(tick.angle) * ora
            local ty = radarCY - math.cos(tick.angle) * ora
            tick.line.From = Vector2.new(fx, fy)
            tick.line.To = Vector2.new(tx, ty)
        end
    end
end

local function updatePlayerArrow()
    local heading = getCamHeading()
    local cx, cy = radarCX, radarCY
    local tipX = cx + math.sin(heading) * ARROW_SIZE
    local tipY = cy - math.cos(heading) * ARROW_SIZE
    local ba1 = heading + math.pi * 0.75
    local ba2 = heading - math.pi * 0.75
    local bs = ARROW_SIZE * 0.65
    local blX = cx + math.sin(ba1) * bs
    local blY = cy - math.cos(ba1) * bs
    local brX = cx + math.sin(ba2) * bs
    local brY = cy - math.cos(ba2) * bs
    local points = {
        Vector2.new(tipX, tipY),
        Vector2.new(blX, blY),
        Vector2.new(brX, brY),
    }
    local pairs = { {1, 2}, {1, 3}, {2, 3} }
    for i, line in ipairs(arrowLines) do
        if line and pairs[i] then
            line.From = points[pairs[i][1]]
            line.To = points[pairs[i][2]]
        end
    end
    if playerDot then
        playerDot.Position = Vector2.new(cx, cy)
    end
end

local function getNPCs()
    local npcs = {}
    local seen = {}
    local playerChars = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            playerChars[p.Character] = true
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") then
            local model = obj.Parent
            if not model or not model:IsA("Model") then
                model = model and model.Parent
            end
            if not model or not model:IsA("Model") then
                goto nextNpc
            end
            if playerChars[model] then
                goto nextNpc
            end
            if seen[model] then
                goto nextNpc
            end
            seen[model] = true
            local root = model:FindFirstChild("HumanoidRootPart")
                or model:FindFirstChild("Torso")
                or model.PrimaryPart
            if root then
                table.insert(npcs, { model = model, humanoid = obj, root = root })
            end
            ::nextNpc::
        end
    end
    return npcs
end

local function updateNPCs()
    local char = LocalPlayer.Character
    if not char then
        for i = 1, MAX_NPCS do
            if npcDots[i] then npcDots[i].Visible = false end
            if npcLines[i] then npcLines[i].Visible = false end
            if npcTexts[i] then npcTexts[i].Visible = false end
        end
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if not root then
        for i = 1, MAX_NPCS do
            if npcDots[i] then npcDots[i].Visible = false end
            if npcLines[i] then npcLines[i].Visible = false end
            if npcTexts[i] then npcTexts[i].Visible = false end
        end
        return
    end
    local playerPos = root.Position
    local radius = currentRadius
    local closeDist = radius * CLOSE_RATIO
    local npcs = getNPCs()
    local displayCount = math.min(#npcs, MAX_NPCS)

    local sorted = {}
    for i, npc in ipairs(npcs) do
        sorted[i] = { npc = npc, dist = (npc.root.Position - playerPos).Magnitude }
    end
    table.sort(sorted, function(a, b) return a.dist < b.dist end)

    for i = 1, MAX_NPCS do
        local dot = npcDots[i]
        local line = npcLines[i]
        local txt = npcTexts[i]

        if i <= displayCount then
            local entry = sorted[i]
            local npc = entry.npc
            local dist = entry.dist

            if dist <= radius then
                local rp = worldToRadar(npc.root.Position, playerPos, radius)
                local color = (dist < closeDist) and COL_RED or COL_ORANGE

                if dot then
                    dot.Position = rp
                    dot.Color = color
                    dot.Visible = true
                end

                if line then
                    local cf = npc.root.CFrame
                    local nh = math.atan2(cf.LookVector.X, cf.LookVector.Z)
                    local dx = rp.X + math.sin(nh) * DIR_LEN
                    local dy = rp.Y - math.cos(nh) * DIR_LEN
                    line.From = rp
                    line.To = Vector2.new(dx, dy)
                    line.Color = color
                    line.Visible = true
                end

                if txt then
                    txt.Position = Vector2.new(rp.X, rp.Y - DOT_R - 8)
                    txt.Text = math.floor(dist) .. "m"
                    txt.Color = color
                    txt.Visible = true
                end
            else
                if dot then dot.Visible = false end
                if line then line.Visible = false end
                if txt then txt.Visible = false end
            end
        else
            if dot then dot.Visible = false end
            if line then line.Visible = false end
            if txt then txt.Visible = false end
        end
    end
end

local function updateAll()
    updateRadarPos()
    if bgCircle then bgCircle.Position = Vector2.new(radarCX, radarCY) end
    if borderCircle then borderCircle.Position = Vector2.new(radarCX, radarCY) end
    if sliderTrack then
        sliderTrack.From = Vector2.new(sliderStartX, sliderY)
        sliderTrack.To = Vector2.new(sliderEndX, sliderY)
    end
    if titleText then
        titleText.Position = Vector2.new(radarCX, radarCY - RADAR_RADIUS - 10)
    end
    updateSlider()
    updateLock()
    updateCompass()
    updatePlayerArrow()
    updateNPCs()
end

-- Input
local function hitSliderThumb(pos)
    if not sliderThumb or not sliderThumb.Visible then return false end
    local tp = sliderThumb.Position
    local dx = pos.X - tp.X
    local dy = pos.Y - tp.Y
    return (dx * dx + dy * dy) <= (THUMB_R + 6) ^ 2
end

local function hitSliderTrack(pos)
    return pos.X >= sliderStartX - 8 and pos.X <= sliderEndX + 8 and math.abs(pos.Y - sliderY) <= 14
end

local function hitLock(pos)
    if not lockBg or not lockBg.Visible then return false end
    local lp = lockBg.Position
    local hs = LOCK_SIZE / 2 + 6
    return math.abs(pos.X - lp.X) <= hs and math.abs(pos.Y - lp.Y) <= hs
end

local function onInputBegan(input, processed)
    if processed then return end
    if not visible then return end
    local pos = nil
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        pos = Vector2.new(input.Position.X, input.Position.Y)
    elseif input.UserInputType == Enum.UserInputType.Touch then
        pos = Vector2.new(input.Position.X, input.Position.Y)
    else
        return
    end
    if hitLock(pos) then
        locked = not locked
        updateSlider()
        updateLock()
        return
    end
    if not locked and hitSliderThumb(pos) then
        dragging = true
        return
    end
    if not locked and hitSliderTrack(pos) then
        local nr = sliderXtoRadius(pos.X)
        if nr ~= currentRadius then
            currentRadius = nr
            updateSlider()
        end
        dragging = true
        return
    end
end

local function onInputChanged(input, processed)
    if not dragging then return end
    if not visible then return end
    if locked then
        dragging = false
        return
    end
    local pos = nil
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        pos = Vector2.new(input.Position.X, input.Position.Y)
    elseif input.UserInputType == Enum.UserInputType.Touch then
        pos = Vector2.new(input.Position.X, input.Position.Y)
    else
        return
    end
    local nr = sliderXtoRadius(pos.X)
    if nr ~= currentRadius then
        currentRadius = nr
        updateSlider()
    end
end

local function onInputEnded(input, processed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end

local inputBegan = UserInputService.InputBegan:Connect(onInputBegan)
local inputChanged = UserInputService.InputChanged:Connect(onInputChanged)
local inputEnded = UserInputService.InputEnded:Connect(onInputEnded)

-- Toggle visibility
local function setVisible(v)
    visible = v
    local objs = { bgCircle, borderCircle, playerDot, sliderTrack, sliderThumb, sliderThumbB, lockBg, lockBorder, lockText, radiusText, titleText }
    for _, obj in ipairs(objs) do
        if obj then pcall(function() obj.Visible = v end) end
    end
    for _, item in ipairs(compassItems) do
        if item.label then pcall(function() item.label.Visible = v end) end
    end
    for _, tick in ipairs(tickLines) do
        if tick.line then pcall(function() tick.line.Visible = v end) end
    end
    for _, line in ipairs(arrowLines) do
        if line then pcall(function() line.Visible = v end) end
    end
    for _, dot in ipairs(npcDots) do
        if dot and not v then pcall(function() dot.Visible = false end) end
    end
    for _, line in ipairs(npcLines) do
        if line and not v then pcall(function() line.Visible = false end) end
    end
    for _, txt in ipairs(npcTexts) do
        if txt and not v then pcall(function() txt.Visible = false end) end
    end
end

local keyToggle = UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        setVisible(not visible)
    end
end)

-- Main loop
local renderConn
renderConn = RunService.RenderStepped:Connect(function()
    if not visible then return end
    pcall(updateAll)
end)

-- Initial paint
pcall(updateAll)

-- Cleanup
local function cleanup()
    if renderConn then renderConn:Disconnect() end
    if inputBegan then inputBegan:Disconnect() end
    if inputChanged then inputChanged:Disconnect() end
    if inputEnded then inputEnded:Disconnect() end
    if keyToggle then keyToggle:Disconnect() end
    local objs = { bgCircle, borderCircle, playerDot, sliderTrack, sliderThumb, sliderThumbB, lockBg, lockBorder, lockText, radiusText, titleText }
    for _, obj in ipairs(objs) do
        if obj then pcall(function() obj:Remove() end) end
    end
    for _, item in ipairs(compassItems) do
        if i
