local Drawing = nil
local success, result = pcall(function()
    if Drawing then return Drawing end
    if getgenv then
        local genv = getgenv()
        if genv.Drawing then return genv.Drawing end
    end
    return nil
end)

if success and result then
    Drawing = result
else
    pcall(function()
        if _G.Drawing then Drawing = _G.Drawing end
    end)
end

if not Drawing then
    warn("[Radar] Drawing library not found. Attempting raw global access...")
    pcall(function()
        Drawing = Drawing or nil
    end)
end

if not Drawing then
    warn("[Radar] Drawing library is not available. Please use a supported executor.")
    return
end

