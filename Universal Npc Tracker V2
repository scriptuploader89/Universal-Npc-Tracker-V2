local function getPlayerHeading()
    local cam = Workspace.CurrentCamera
    if not cam then return 0 end
    local cf = cam.CFrame
    local look = cf.LookVector
    return math.atan2(look.X, look.Z)
end

local function worldToRadar(worldPos, playerPos, heading, radius)
    local dx = worldPos.X - playerPos.X
    local dz = worldPos.Z - playerPos.Z
    local dist = math.sqrt(dx * dx + dz * dz)
    local scale = CONFIG.RADAR_RADIUS / radius
    local scaledDist = dist * scale
    local clampedDist = math.min(scaledDist, CONFIG.RADAR_RADIUS - CONFIG.NPC_DOT_RADIUS - 2)

    if dist < 0.01 then
        return state.radarCenter, 0, 0, 0
    end

    local worldAngle = math.atan2(dx, dz)
    local sx = state.radarCenter.X + math.sin(worldAngle) * clampedDist
    local sy = state.radarCenter.Y - math.cos(worldAngle) * clampedDist

    return Vector2.new(sx, sy), dist, worldAngle, clampedDist
end

local function isOnSliderThumb(pos)
    if not sliderThumb.Visible then return false end
    local tp = sliderThumb.Position
    local dx = pos.X - tp.X
    local dy = pos.Y - tp.Y
    return (dx * dx + dy * dy) <= (CONFIG.THUMB_RADIUS + 6) ^ 2
end

local function isOnSliderTrack(pos)
    if not sliderTrack.Visible then return false end
    return pos.X >= state.sliderStartX - 8
        and pos.X <= state.sliderEndX + 8
        and math.abs(pos.Y - state.sliderY) <= 14
end

local function isOnLockButton(pos)
    if not lockBg.Visible then return false end
    local lockPos = lockBg.Position
    local halfSize = CONFIG.LOCK_SIZE / 2 + 6
    return math.abs(pos.X - lockPos.X) <= halfSize
        and math.abs(pos.Y - lockPos.Y) <= halfSize
end

local function sliderPosToRadius(x)
    local ratio = (x - state.sliderStartX) / CONFIG.SLIDER_WIDTH
    ratio = math.clamp(ratio, 0, 1)
    return math.floor(1 + ratio * (CONFIG.MAX_TRACKING_RADIUS - 1))
end

local function radiusToSliderX(radius)
    local ratio = (radius - 1) / (CONFIG.MAX_TRACKING_RADIUS - 1)
    return state.sliderStartX + ratio * CONFIG.SLIDER_WIDTH
end

local function updateSliderVisuals()
    local thumbX = radiusToSliderX(state.currentRadius)
    local thumbPos = Vector2.new(thumbX, state.sliderY)
    if sliderThumb then
        sliderThumb.Position = thumbPos
        sliderThumb.Color = state.locked
            and Color3.fromRGB(120, 120, 130)
            or CONFIG.COLOR_SLIDER_THUMB
    end
    if sliderThumbBorder then
        sliderThumbBorder.Position = thumbPos
        sliderThumbBorder.Color = state.locked
            and Color3.fromRGB(160, 160, 160)
            or Color3.fromRGB(255, 255, 255)
    end
    if radiusText then
        radiusText.Text = "Radius: " .. state.currentRadius .. "m"
        radiusText.Position = Vector2.new(state.radarCenter.X, state.sliderY + 18)
        radiusText.Color = state.locked
            and Color3.fromRGB(180, 180, 180)
            or CONFIG.COLOR_TEXT
    end
end

local function updateLockVisuals()
    local lockCenter = Vector2.new(state.sliderEndX + CONFIG.LOCK_SIZE / 2 + 12, state.sliderY)
    if lockBg then
        lockBg.Position = lockCenter
        lockBg.Color = state.locked and CONFIG.COLOR_LOCK_LOCKED or CONFIG.COLOR_LOCK_UNLOCKED
    end
    if lockBorder then
        lockBorder.Position = lockCenter
    end
    if lockText then
        lockText.Position = lockCenter
        lockText.Text = state.locked and "L" or "U"
    end
end

local function updateCompass()
    for _, entry in ipairs(compassLabels) do
        if entry.label then
            local screenAngle = entry.angle
            local lx = state.radarCenter.X + math.sin(screenAngle) * (CONFIG.RADAR_RADIUS + 12)
            local ly = state.radarCenter.Y - math.cos(screenAngle) * (CONFIG.RADAR_RADIUS + 12)
            entry.label.Position = Vector2.new(lx, ly)
            entry.label.Color = (entry.angle == 0) and Color3.fromRGB(255, 220, 100) or CONFIG.COLOR_COMPASS
        end
    end

    for _, tick in ipairs(compassTicks) do
        if tick.line then
            local innerR = CONFIG.RADAR_RADIUS - 6
            local outerR = CONFIG.RADAR_RADIUS - 2
            local fx = state.radarCenter.X + math.sin(tick.angle) * innerR
            local fy = state.radarCenter.Y - math.cos(tick.angle) * innerR
            local tx = state.radarCenter.X + math.sin(tick.angle) * outerR
            local ty = state.radarCenter.Y - math.cos(tick.angle) * outerR
            tick.line.From = Vector2.new(fx, fy)
            tick.line.To = Vector2.new(tx, ty)
        end
    end
end

local function updatePlayerArrow()
    local heading = getPlayerHeading()
    local cx = state.radarCenter.X
    local cy = state.radarCenter.Y
    local arrowSize = CONFIG.PLAYER_ARROW_SIZE

    local tipX = cx + math.sin(heading) * arrowSize
    local tipY = cy - math.cos(heading) * arrowSize

    local baseAngle1 = heading + math.pi * 0.75
    local baseAngle2 = heading - math.pi * 0.75
    local baseSize = arrowSize * 0.65

    local blX = cx + math.sin(baseAngle1) * baseSize
    local blY = cy - math.cos(baseAngle1) * baseSize
    local brX = cx + math.sin(baseAngle2) * baseSize
    local brY = cy - math.cos(baseAngle2) * baseSize

    local tip = Vector2.new(tipX, tipY)
    local bl = Vector2.new(blX, blY)
    local br = Vector2.new(brX, brY)

    local lineDefs = {
        {from = tip, to = bl},
        {from = tip, to = br},
        {from = bl, to = br},
    }

    for i, line in ipairs(playerArrowLines) do
        if line and lineDefs[i] then
            line.From = lineDefs[i].from
            line.To = lineDefs[i].to
        end
    end

    if playerDot then
        playerDot.Position = Vector2.new(cx, cy)
    end
end

local function getNPCs()
    local npcs = {}
    local seen = {}

    local playerChars = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            playerChars[player.Character] = true
        end
    end

    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("Humanoid") then
            local model = descendant.Parent
            if not model or not model:IsA("Model") then
                model = model and model.Parent
                if not model or not model:IsA("Model") then
                    goto continue
                end
            end

            if playerChars[model] then
                goto continue
            end

            if seen[model] then
                goto continue
            end
            seen[model] = true

            local rootPart = model:FindFirstChild("HumanoidRootPart")
                or model:FindFirstChild("Torso")
                or model.PrimaryPart

            if rootPart then
                table.insert(npcs, {
                    model = model,
                    humanoid = descendant,
                    rootPart = rootPart,
                })
            end

            ::continue::
        end
    end

    return npcs
end

local function updateNPCDisplay()
    local playerChar = LocalPlayer.Character
    if not playerChar then
        for i = 1, CONFIG.MAX_DISPLAYED_NPCS do
            if npcDotPool[i] then npcDotPool[i].Visible = false end
            if npcDirLinePool[i] then npcDirLinePool[i].Visible = false end
            if npcTextPool[i] then npcTextPool[i].Visible = false end
        end
        return
    end

    local playerRoot = playerChar:FindFirstChild("HumanoidRootPart") or playerChar.PrimaryPart
    if not playerRoot then
        for i = 1, CONFIG.MAX_DISPLAYED_NPCS do
            if npcDotPool[i] then npcDotPool[i].Visible = false end
            if npcDirLinePool[i] then npcDirLinePool[i].Visible = false end
            if npcTextPool[i] then npcTextPool[i].Visible = false end
        end
        return
    end

    local playerPos = playerRoot.Position
    local heading = getPlayerHeading()
    local radius = state.currentRadius
    local closeThreshold = radius * CONFIG.CLOSE_DISTANCE_RATIO

    local npcs = getNPCs()
    local displayCount = math.min(#npcs, CONFIG.MAX_DISPLAYED_NPCS)

    local npcDistances = {}
    for i, npc in ipairs(npcs) do
        local dist = (npc.rootPart.Position - playerPos).Magnitude
        npcDistances[i] = {npc = npc, dist = dist}
    end
    table.sort(npcDistances, function(a, b) return a.dist < b.dist end)

    for i = 1, CONFIG.MAX_DISPLAYED_NPCS do
        local dot = npcDotPool[i]
        local dirLine = npcDirLinePool[i]
        local txt = npcTextPool[i]

        if i <= displayCount then
            local entry = npcDistances[i]
            local npc = entry.npc
            local dist = entry.dist

            if dist <= radius then
                local radarPos = worldToRadar(npc.rootPart.Position, playerPos, heading, radius)

                local color = (dist < closeThreshold) and CONFIG.COLOR_RED or CONFIG.COLOR_ORANGE

                if dot then
                    dot.Position = radarPos
                    dot.Color = color
                    dot.Visible = true
                end

                if dirLine then
                    local npcHeading = math.atan2(
                        npc.rootPart.CFrame.LookVector.X,
                        npc.rootPart.CFrame.LookVector.Z
                    )
                    local dirX = radarPos.X + math.sin(npcHeading) * CONFIG.NPC_DIR_LINE_LENGTH
                    local dirY = radarPos.Y - math.cos(npcHeading) * CONFIG.NPC_DIR_LINE_LENGTH
                    dirLine.From = radarPos
                    dirLine.To = Vector2.new(dirX, dirY)
                    dirLine.Color = color
                    dirLine.Visible = true
                end

                if txt then
                    local labelPos = Vector2.new(radarPos.X, radarPos.Y - CONFIG.NPC_DOT_RADIUS - 8)
                    txt.Position = labelPos
                    txt.Text = math.floor(dist) .. "m"
                    txt.Color = color
                    txt.Visible = true
                end
            else
                if dot then dot.Visible = false end
                if dirLine then dirLine.Visible = false end
                if txt then txt.Visible = false end
            end
        else
            if dot then dot.Visible = false end
            if dirLine then dirLine.Visible = false end
            if txt then txt.Visible = false end
        end
    end
end

local function updateAllVisuals()
    updateRadarPosition()

    if bgCircle then bgCircle.Position = state.radarCenter end
    if borderCircle then borderCircle.Position = state.radarCenter end

    if sliderTrack then
        sliderTrack.From = Vector2.new(state.sliderStartX, state.sliderY)
        sliderTrack.To = Vector2.new(state.sliderEndX, state.sliderY)
    end

    if titleText then
        titleText.Position = Vector2.new(state.radarCenter.X, state.radarCenter.Y - CONFIG.RADAR_RADIUS - 10)
    end

    updateSliderVisuals()
    updateLockVisuals()
    updateCompass()
    updatePlayerArrow()
    updateNPCDisplay()
end

local function handleInputBegan(input, gameProcessed)
    if gameProcessed then return end
    if not CONFIG.VISIBLE then return end

    local pos
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        pos = Vector2.new(input.Position.X, input.Position.Y)
    elseif input.UserInputType == Enum.UserInputType.Touch then
        pos = Vector2.new(input.Position.X, input.Position.Y)
    else
        return
    end

    if isOnLockButton(pos) then
        state.locked = not state.locked
        updateLockVisuals()
        return
    end

    if not state.locked and isOnSliderThumb(pos) then
        state.dragging = true
        return
    end

    if not state.locked and isOnSliderTrack(pos) then
        local newRadius = sliderPosToRadius(pos.X)
        if newRadius ~= state.currentRadius then
            state.currentRadius = newRadius
            updateSliderVisuals()
        end
        state.dragging = true
        return
    end
end

local function handleInputChanged(input, gameProcessed)
    if not state.dragging then return end
    if not CONFIG.VISIBLE then return end
    if state.locked then
        state.dragging = false
        return
    end

    local pos
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        pos = Vector2.new(input.Position.X, input.Position.Y)
    elseif input.UserInputType == Enum.UserInputType.Touch then
        pos = Vector2.new(input.Position.X, input.Position.Y)
    else
        return
    end

    local newRadius = sliderPosToRadius(pos.X)
    if newRadius ~= state.currentRadius then
        state.currentRadius = newRadius
        updateSliderVisuals()
    end
end

local function handleInputEnded(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        state.dragging = false
    end
end

local inputBeganConn = UserInputService.InputBegan:Connect(handleInputBegan)
local inputChangedConn = UserInputService.InputChanged:Connect(handleInputChanged)
local inputEndedConn = UserInputService.InputEnded:Connect(handleInputEnded)

local function setAllVisible(visible)
    CONFIG.VISIBLE = visible
    local allObjects = {
        bgCircle, borderCircle, playerDot,
        sliderTrack, sliderThumb, sliderThumbBorder,
        lockBg, lockBorder, lockText, radiusText, titleText,
    }
    for _, obj in ipairs(allObjects) do
        if obj then
            pcall(function() obj.Visible = visible end)
        end
    end
    for _, entry in ipairs(compassLabels) do
        if entry.label then
            pcall(function() entry.label.Visible = visible end)
        end
    end
    for _, tick in ipairs(compassTicks) do
        if tick.line then
            pcall(function() tick.line.Visible = visible end)
        end
    end
    for _, line in ipairs(playerArrowLines) do
        if line then
            pcall(function() line.Visible = visible end)
        end
    end
    for _, dot in ipairs(npcDotPool) do
        if dot and not visible then
            pcall(function() dot.Visible = false end)
        end
    end
    for _, line in ipairs(npcDirLinePool) do
        if line and not visible then
            pcall(function() line.Visible = false end)
        end
    end
    for _, txt in ipairs(npcTextPool) do
        if txt and not visible then
            pcall(function() txt.Visible = false end)
        end
    end
end

local keyToggleConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        setAllVisible(not CONFIG.VISIBLE)
    end
end)

local updateConnection
updateConnection = RunService.RenderStepped:Connect(function()
    if not CONFIG.VISIBLE then return end
    local success, err = pcall(updateAllVisuals)
    if not success then
        warn("[Radar] Update error:", err)
    end
end)

pcall(updateAllVisuals)

local function cleanup()
    if updateConnection then updateConnection:Disconnect() end
    if inputBeganConn then inputBeganConn:Disconnect() end
    if inputChangedConn then inputChangedConn:Disconnect() end
    if inputEndedConn then inputEndedConn:Disconnect() end
    if keyToggleConn then keyToggleConn:Disconnect() end

    local allObjects = {
        bgCircle, borderCircle, playerDot,
        sliderTrack, sliderThumb, sliderThumbBorder,
        lockBg, lockBorder, lockText, radiusText, titleText,
    }
    for _, obj in ipairs(allObjects) do
        if obj then pcall(function() obj:Remove() end) end
    end
    for _, entry in ipairs(compassLabels) do
        if entry.label then pcall(function() entry.label:Remove() end) end
    end
    for _, tick in ipairs(compassTicks) do
        if tick.line then pcall(function() tick.line:Remove() end) end
    end
    for _, line in ipairs(playerArrowLines) do
        if line then pcall(function() line:Remove() end) end
    end
    for _, dot in ipairs(npcDotPool) do
        if dot then pcall(function() dot:Remove() end) end
    end
    for _, line in ipairs(npcDirLinePool) do
        if line then pcall(function() line:Remove() end) end
    end
    for _, txt in ipairs(npcTextPool) do
        if txt then pcall(function() txt:Remove() end) end
    end
end

getgenv().RadarCleanup = cleanup

