-- Helpers
local function createDraw(dtype, props)
    local ok, obj = pcall(function()
        return Drawing.new(dtype)
    end)
    if not ok or not obj then
        return nil
    end
    for k, v in pairs(props) do
        pcall(function()
            obj[k] = v
        end)
    end
    return obj
end

local function updateRadarPos()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    radarCX = vp.X - RADAR_RADIUS - 30
    radarCY = RADAR_RADIUS + 40
    sliderY = radarCY + RADAR_RADIUS + 20
    sliderStartX = radarCX - SLIDER_W / 2
    sliderEndX = radarCX + SLIDER_W / 2
end
updateRadarPos()

