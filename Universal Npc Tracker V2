-- Find Drawing library
local Drawing = nil
if getgenv and getgenv().Drawing then
    Drawing = getgenv().Drawing
end
if not Drawing and _G.Drawing then
    Drawing = _G.Drawing
end
if not Drawing and Drawing ~= nil then
    -- Drawing is already a global in some executors
elseif not Drawing then
    pcall(function()
        Drawing = Drawing
    end)
end
if not Drawing then
    print("[Radar] ERROR: Drawing library not found. Use an executor with Drawing support.")
    return
end

