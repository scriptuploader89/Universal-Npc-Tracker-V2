        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- Main update loop
RunService.RenderStepped:Connect(function()
    if not radarEnabled then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local playerPos = humanoidRootPart.Position
    local playerLook = humanoidRootPart.CFrame.LookVector
    local playerAngle = math.atan2(playerLook.X, playerLook.Z)
    
    -- Update compass
    local compassAngle = math.deg(math.atan2(playerLook.X, playerLook.Z))
    if compassAngle < 0 then compassAngle = compassAngle + 360 end
    CompassLabel.Text = getCompassDirection(compassAngle)
    
    -- Update player arrow rotation
    PlayerArrow.Rotation = 0
    
    -- Hide all dots first
    hideAllDots()
    
    -- Get and display NPCs
    local npcs = getNPCs()
    
    for _, npc in ipairs(npcs) do
        local npcRoot = npc:FindFirstChild("HumanoidRootPart")
        if npcRoot then
            local npcPos = npcRoot.Position
            local offset = npcPos - playerPos
            local distance = offset.Magnitude
            
            if distance <= currentRadius then
                local dot = getDot()
                
                -- Calculate position on radar
                local relX = offset.X / currentRadius
                local relZ = offset.Z / currentRadius
                
                -- Rotate based on player facing direction
                local rotatedX = relX * math.cos(-playerAngle) - relZ * math.sin(-playerAngle)
                local rotatedZ = relX * math.sin(-playerAngle) + relZ * math.cos(-playerAngle)
                
                -- Scale to radar size
                local radarX = 0.5 + (rotatedX * 0.45)
                local radarY = 0.5 - (rotatedZ * 0.45)
                
                -- Clamp to circle
                local distFromCenter = math.sqrt((radarX - 0.5)^2 + (radarY - 0.5)^2)
                if distFromCenter > 0.45 then
                    local scale = 0.45 / distFromCenter
                    radarX = 0.5 + (radarX - 0.5) * scale
                    radarY = 0.5 + (radarY - 0.5) * scale
                end
                
                dot.Position = UDim2.new(radarX, -6, radarY, -6)
                
                -- Color based on distance
                if distance <= CLOSE_DISTANCE then
                    dot.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                else
                    dot.BackgroundColor3 = Color3.fromRGB(255, 165, 0)
                end
                
                -- NPC direction indicator
                local npcLook = npcRoot.CFrame.LookVector
                local npcAngle = math.deg(math.atan2(npcLook.X, npcLook.Z))
                local relativeAngle = npcAngle - math.deg(playerAngle)
                dot.Rotation = -relativeAngle
                
                -- Distance label
                dot.Distance.Text = math.floor(distance) .. "m"
                
                dot.Visible = true
            end
        end
    end
end)

