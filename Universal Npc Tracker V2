local function getDot()
    for _, dot in ipairs(dotPool) do
        if not dot.Visible then
            return dot
        end
    end
    local newDot = createDot()
    table.insert(dotPool, newDot)
    return newDot
end

local function hideAllDots()
    for _, dot in ipairs(dotPool) do
        dot.Visible = false
    end
end

-- Utility functions
local function getCompassDirection(angle)
    local directions = {"N", "NE", "E", "SE", "S", "SW", "W", "NW"}
    local index = math.floor(((angle + 22.5) % 360) / 45) + 1
    return directions[index]
end

local function isNPC(model)
    if not model:IsA("Model") then return false end
    if not model:FindFirstChild("Humanoid") then return false end
    if not model:FindFirstChild("HumanoidRootPart") then return false end
    
    -- Check if it belongs to a player
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character == model then
            return false
        end
    end
    
    return true
end

local function getNPCs()
    local npcs = {}
    
    local function searchFolder(folder)
        for _, obj in ipairs(folder:GetChildren()) do
            if isNPC(obj) then
                table.insert(npcs, obj)
            elseif obj:IsA("Folder") or obj:IsA("Model") then
                searchFolder(obj)
            end
        end
    end
    
    searchFolder(Workspace)
    return npcs
end

-- Slider functionality
local function updateSlider(value)
    if isLocked then return end
    
    value = math.clamp(value, MIN_RADIUS, MAX_RADIUS)
    currentRadius = math.floor(value)
    
    local percent = (currentRadius - MIN_RADIUS) / (MAX_RADIUS - MIN_RADIUS)
    SliderFill.Size = UDim2.new(percent, 0, 1, 0)
    SliderKnob.Position = UDim2.new(percent, -8, 0.5, -8)
    RadiusLabel.Text = "Radius: " .. currentRadius
end

local function handleSliderInput(input)
    if isLocked then return end
    
    local sliderPos = SliderBar.AbsolutePosition
    local sliderSize = SliderBar.AbsoluteSize
    
    local relativeX = math.clamp((input.Position.X - sliderPos.X) / sliderSize.X, 0, 1)
    local newValue = MIN_RADIUS + (relativeX * (MAX_RADIUS - MIN_RADIUS))
    updateSlider(newValue)
end

