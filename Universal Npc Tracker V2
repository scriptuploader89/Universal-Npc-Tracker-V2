-- =====================================================================
-- UTILITY FUNCTIONS
-- =====================================================================
local function IsNPC(instance)
    if not instance then return false end
    -- NPCs are typically non-player characters with Humanoid
    local isPlayer = Players:GetPlayerFromCharacter(instance)
    if isPlayer then return false end

    -- Must have a Humanoid
    local humanoid = instance:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end

    -- Must be a model (character-like)
    if not instance:IsA("Model") then return false end

    -- Health > 0 means alive
    if humanoid.Health <= 0 then return false end

    -- Has a HumanoidRootPart or PrimaryPart for position
    local root = instance:FindFirstChild("HumanoidRootPart") or instance.PrimaryPart
    if not root then return false end

    return true
end

local function GetNPCPosition(npc)
    local root = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
    if root then
        return root.Position
    end
    return nil
end

local function GetNPCDirection(npc)
    local root = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
    if root then
        -- The CFrame lookVector gives the direction the NPC is facing
        local lookVector = root.CFrame.LookVector
        return math.atan2(-lookVector.X, -lookVector.Z) -- angle in radians
    end
    return 0
end

local function GetCompassDirection(cframe)
    local _, _, _, _, _, _, 
          _, _, _, 
          a, b, c = cframe:GetComponents()
    -- Forward vector from CFrame
    local forward = Vector3.new(-a, -b, -c)
    local angle = math.atan2(forward.X, -forward.Z)
    local degrees = math.deg(angle)
    if degrees < 0 then degrees = degrees + 360 end

    if degrees >= 315 or degrees < 45 then return "N", degrees end
    if degrees >= 45 and degrees < 135 then return "E", degrees end
    if degrees >= 135 and degrees < 225 then return "S", degrees end
    if degrees >= 225 and degrees < 315 then return "W", degrees end
    return "N", degrees
end

local function RoundNumber(num)
    return math.floor(num * 10 + 0.5) / 10
end

